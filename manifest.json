{
  "manifest_version": 3,
  "name": "Quick Summarize",
  "version": "0.1.0",
  "description": "Summarize text, a selection, or the current page with a local llama-server.",
  "action": { "default_title": "Quick Summarize" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "contextMenus", "storage", "scripting", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
